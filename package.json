{
  "name": "bootstrap-llm-provider",
  "version": "1.3.1",
  "description": "Let users pick their OpenAI compatible API provider (e.g. OpenRouter, Ollama) via a Bootstrap modal",
  "homepage": "https://sanand0.github.io/bootstrap-llm-provider/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanand0/bootstrap-llm-provider.git"
  },
  "license": "MIT",
  "author": "Anand S <root.node@gmail.com>",
  "type": "module",
  "module": "./dist/bootstrap-llm-provider.js",
  "types": "./dist/bootstrap-llm-provider.d.ts",
  "prettier": {
    "printWidth": 120
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "browser": "dist/bootstrap-llm-provider.js",
  "exports": {
    ".": {
      "types": "./dist/bootstrap-llm-provider.d.ts",
      "default": "./dist/bootstrap-llm-provider.js"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild bootstrap-llm-provider.ts --format=esm --bundle --minify --allow-overwrite --sourcemap --outfile=dist/bootstrap-llm-provider.js",
    "lint:oxlint": "oxlint --fix",
    "lint:js-md": "prettier --print-width 120 --write '**/*.{js,ts}' '!**/*.min.js' '!dist/**' '**/*.md'",
    "lint:html": "js-beautify '**/*.html' --type html --replace --indent-size 2 --max-preserve-newlines 1 --end-with-newline",
    "lint:type": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "npm run lint:oxlint && npm run lint:js-md && npm run lint:html && npm run lint:type",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.7"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "jsdom": "^24.0.0",
    "@types/jsdom": "^21.1.6",
    "js-beautify": "^1.15.4",
    "oxlint": "^1.16.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "bootstrap",
    "llm",
    "provider"
  ]
}
